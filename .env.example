# SMTP credentials used by the server to send "Get Quote" form submissions.
# These are read server-side only and are never exposed to the browser.
#
# Copy this file to .env and fill in real values — .env is gitignored,
# .env.example is committed as a template and must never contain real
# secrets.
#
# For Zoho Mail: host depends on which data center your account is on —
# smtp.zoho.com (global), smtp.zoho.in (India), or smtp.zoho.eu (Europe).
# Port 465 with SMTP_SECURE=true (or port 587 with SMTP_SECURE=false).
# Use an app-specific password if your account has 2FA enabled.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=connect@savitron.ai
SMTP_PASS=
QUOTE_RECIPIENT=connect@savitron.ai

# Zoho CRM Web-to-Lead form identifiers (from the generated form's hidden
# fields). Not API credentials, but rotate here rather than in source if
# the form is ever regenerated.
ZOHO_XNQSJSDP=
ZOHO_XMIWTLD=
